<style>
  .login-container {
    min-height: 100vh;
    background-color: #f3f4f6;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .login-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .button-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background-color: #e0e7ff;
    border: 2px solid #c7d2fe;
    border-radius: 50%;
    margin-bottom: 0.75rem;
  }

  .button-svg {
    width: 32px;
    height: 32px;
    fill: #6366f1;
  }

  .login-title {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1e1b4b;
  }

  .login-subtitle {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #4338ca;
  }

  .login-card {
    width: 100%;
    max-width: 400px;
    background-color: #ffffff;
    padding: 2rem;
    border-radius: 12px;
    border: 1px solid #e0e7ff;
    box-shadow: 0 4px 6px -1px rgba(199, 210, 255, 0.4), 0 2px 4px -1px rgba(199, 210, 255, 0.2);
    box-sizing: border-box;
  }

  .field-group {
    margin-bottom: 1.25rem;
  }

  .field-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: #312e81;
    margin-bottom: 0.375rem;
  }

  .input-field {
    width: 100%;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    border: 1px solid #c7d2fe;
    border-radius: 6px;
    box-sizing: border-box;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    outline: none;
  }

  .input-field:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  }

  .checkbox-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .checkbox-input {
    width: 16px;
    height: 16px;
    accent-color: #6366f1;
    cursor: pointer;
  }

  .checkbox-label {
    font-size: 0.875rem;
    color: #3730a3;
    margin: 0;
    cursor: pointer;
  }

  .submit-btn {
    width: 100%;
    padding: 0.625rem;
    background-color: #6366f1;
    color: #ffffff;
    font-size: 0.875rem;
    font-weight: 600;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .submit-btn:hover {
    background-color: #4f46e5;
  }

  .shared-links {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e0e7ff;
    text-align: center;
    font-size: 0.875rem;
    color: #4338ca;
  }

  .shared-links a {
    color: #4f46e5;
    text-decoration: none;
  }

  .shared-links a:hover {
    text-decoration: underline;
  }
</style>

<div class="login-container">
  <div class="login-header">
    <!-- Sewing Button Icon -->
    <div class="button-icon-wrapper">
      <svg class="button-svg" viewBox="0 0 24 24">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm0 2a8 8 0 100 16 8 8 0 000-16z"/>
        <circle cx="9.5" cy="9.5" r="1.25"/>
        <circle cx="14.5" cy="9.5" r="1.25"/>
        <circle cx="9.5" cy="14.5" r="1.25"/>
        <circle cx="14.5" cy="14.5" r="1.25"/>
      </svg>
    </div>

    <h2 class="login-title">Welcome Back</h2>
    <p class="login-subtitle">Please log in to your account</p>
  </div>

  <div class="login-card">
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="field-group">
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field" %>
      </div>

      <div class="field-group">
        <%= f.label :password, class: "field-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "input-field" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="checkbox-group">
          <%= f.check_box :remember_me, class: "checkbox-input" %>
          <%= f.label :remember_me, class: "checkbox-label" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Log in", class: "submit-btn" %>
      </div>
    <% end %>

    <div class="shared-links">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>